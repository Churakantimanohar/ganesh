rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if admin()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if admin();
    }

    match /donations/{donationId} {
      allow read: if admin()
        || (signedIn() && resource.data.donorId == request.auth.uid);
      allow create: if admin()
        || (signedIn()
          && request.resource.data.donorId == request.auth.uid
          && request.resource.data.status == 'pending');
      allow update, delete: if admin();
    }

    match /expenses/{expenseId} {
      allow read, write: if admin();
    }

    match /publicDonations/{donationId} {
      allow read: if true;
      allow write: if admin();
    }

    match /publicExpenses/{expenseId} {
      allow read: if true;
      allow write: if admin();
    }

    match /settings/{settingId} {
        // Authenticated donors can load the UPI scanner URL
        allow read: if request.auth != null;

        // Only an explicitly configured admin can change settings
        allow create, update: if request.auth != null
                              && get(
                                /databases/$(database)
                                /documents/users/$(request.auth.uid)
                              ).data.role == "admin";

        allow delete: if request.auth != null
                      && get(
                        /databases/$(database)
                        /documents/users/$(request.auth.uid)
                      ).data.role == "admin";
    }
  }
}
